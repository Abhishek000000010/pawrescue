## 4. MongoDB Data Models

### User
```javascript
{
  _id, name, email, password (hashed), phone, avatar (cloudinary url),
  role: ['citizen', 'volunteer', 'foster', 'vet', 'admin'],
  location: { city, state, coordinates: { lat, lng } },
  volunteerRoles: ['rescue', 'feeding', 'transport', 'fostering', 'medical'],
  points: Number,
  badges: [{ name, icon, earnedAt }],
  reportsCount, missionsCompleted, catsRescued, catsAdopted,
  isVerified: Boolean,
  createdAt, updatedAt
}
```

### Cat
```javascript
{
  _id,
  name: String (optional, assigned later),
  photos: [cloudinary_url],
  location: {
    address: String,
    area: String,
    city: String,
    coordinates: { lat: Number, lng: Number }
  },
  severity: { type: String, enum: ['critical', 'moderate', 'stable'] },
  aiSeverityReason: String,
  condition: String,
  status: {
    type: String,
    enum: ['reported', 'rescue_assigned', 'rescued', 'in_care', 'ready_for_adoption', 'adopted', 'deceased']
  },
  reportedBy: { type: ObjectId, ref: 'User' },
  assignedVolunteer: { type: ObjectId, ref: 'User' },
  rescueTimeline: [{
    status: String, note: String, updatedBy: ObjectId, timestamp: Date
  }],
  tags: [String],
  isAvailableForAdoption: Boolean,
  fosterHome: { type: ObjectId, ref: 'FosterHome' },
  vetVisits: [{ vet: ObjectId, date: Date, notes: String, cost: Number }],
  donationsReceived: Number,
  colonyId: String,
  createdAt, updatedAt
}
```

### Mission
```javascript
{
  _id,
  type: { type: String, enum: ['feeding', 'transport', 'vet_visit', 'temp_shelter', 'rescue', 'colony_check'] },
  title: String,
  description: String,
  cat: { type: ObjectId, ref: 'Cat' },
  location: { address, coordinates: { lat, lng } },
  status: { type: String, enum: ['open', 'claimed', 'in_progress', 'completed', 'cancelled'] },
  claimedBy: { type: ObjectId, ref: 'User' },
  createdBy: { type: ObjectId, ref: 'User' },
  pointsReward: Number,
  urgency: { type: String, enum: ['urgent', 'normal', 'low'] },
  dueBy: Date,
  completionProof: [String],
  completedAt: Date,
  createdAt
}
```

### Adoption
```javascript
{
  _id,
  cat: { type: ObjectId, ref: 'Cat' },
  applicant: { type: ObjectId, ref: 'User' },
  status: { type: String, enum: ['pending', 'approved', 'rejected', 'completed'] },
  applicationAnswers: {
    housingType: String,
    hasOtherPets: Boolean,
    hasChildren: Boolean,
    experience: String,
    reason: String,
    monthlyBudget: Number
  },
  reviewedBy: { type: ObjectId, ref: 'User' },
  reviewNote: String,
  createdAt
}
```

### Donation
```javascript
{
  _id,
  donor: { type: ObjectId, ref: 'User' },
  amount: Number,
  purpose: { type: String, enum: ['rescue_mission', 'medical', 'feeding', 'shelter', 'general'] },
  cat: { type: ObjectId, ref: 'Cat' },
  razorpayOrderId: String,
  razorpayPaymentId: String,
  status: { type: String, enum: ['pending', 'success', 'failed'] },
  message: String,
  isAnonymous: Boolean,
  createdAt
}
```

### Post (Community)
```javascript
{
  _id,
  author: { type: ObjectId, ref: 'User' },
  type: { type: String, enum: ['update', 'story', 'request', 'tip'] },
  content: String,
  images: [String],
  cat: { type: ObjectId, ref: 'Cat' },
  likes: [{ type: ObjectId, ref: 'User' }],
  comments: [{
    author: ObjectId, content: String, createdAt: Date
