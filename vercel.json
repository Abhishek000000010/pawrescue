{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://pawrescue-yioy.onrender.com/api/:path*"
    },
    {
      "source": "/overpass/:path*",
      "destination": "https://overpass-api.de/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
